{
  "name": "hermes-pet-overlay",
  "version": "0.1.0",
  "description": "Hermes Pets desktop overlay — floating companion sprite",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:linux": "electron . --hermes-pet-platform=linux",
    "start:wsl": "electron . --hermes-pet-platform=wsl",
    "start:windows": "electron . --hermes-pet-platform=win32",
    "start:macos": "electron . --hermes-pet-platform=darwin"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "ws": "^8.18.0"
  }
}
